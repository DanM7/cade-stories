{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cade-stories/article.schema.json",
  "title": "Article",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "lead", "body"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "lead": { "type": "string", "minLength": 1 },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "pullQuote": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
