{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cade-stories/newspaper-page.schema.json",
  "title": "NewspaperPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "articles", "quotes", "weather", "classifieds"],
  "properties": {
    "headline": { "$ref": "./headline.schema.json" },
    "articles": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "./article.schema.json" }
    },
    "quotes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./quote.schema.json" }
    },
    "weather": { "$ref": "./weather.schema.json" },
    "classifieds": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "./classified.schema.json" }
    }
  }
}
